# ── Stage 1: Install & Build ──────────────────────────────────────
FROM node:20-alpine AS builder
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

# Force development mode during dependency installation so devDependencies (TypeScript, compilers) are installed
ENV NODE_ENV=development

# Copy root manifests
COPY package.json package-lock.json ./

# Copy all workspace package manifests so npm workspace graph is complete
COPY packages/shared/package.json ./packages/shared/
COPY backend/package.json         ./backend/
COPY frontend/package.json        ./frontend/

# Install ALL workspace dependencies from the root including devDependencies
RUN npm ci --include=dev

# Copy source files
COPY packages/shared/ ./packages/shared/
COPY backend/         ./backend/

# Build shared package first (server depends on it)
RUN cd packages/shared && npm run build

# Generate Prisma client
RUN cd backend && npx prisma generate

# Set NODE_ENV to production for backend build
ENV NODE_ENV=production

# Build Express server (TypeScript → dist/)
RUN cd backend && npm run build

# ── Stage 2: Production image ──────────────────────────────────────
FROM node:20-alpine AS runner
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app
ENV NODE_ENV=production
ENV PATH="/app/node_modules/.bin:$PATH"

# Copy only what is needed to run
COPY --from=builder /app/package.json          ./
COPY --from=builder /app/node_modules          ./node_modules
COPY --from=builder /app/packages/shared/dist  ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/backend/dist          ./backend/dist
COPY --from=builder /app/backend/prisma        ./backend/prisma
COPY --from=builder /app/backend/package.json  ./backend/

WORKDIR /app/backend
EXPOSE 4000

# Start server: run prisma db push directly using node to create tables, then launch express
CMD ["sh", "-c", "node /app/node_modules/prisma/build/index.js db push --schema=/app/backend/prisma/schema.prisma --skip-generate --accept-data-loss; node dist/index.js"]
