# ── Stage 1: Install & Build ──────────────────────────────────────
FROM node:20-alpine AS builder
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app

# Force development mode during build so devDependencies (TypeScript, compilers) are installed
ENV NODE_ENV=development

# Copy root manifests
COPY package.json package-lock.json ./

# Copy workspace package manifests (needed for npm ci to resolve workspaces)
COPY packages/shared/package.json ./packages/shared/
COPY backend/package.json         ./backend/

# Install ALL workspace dependencies from the root including devDependencies
RUN npm ci --include=dev

# Copy source files
COPY packages/shared/ ./packages/shared/
COPY backend/         ./backend/

# Build shared package first (server depends on it)
RUN cd packages/shared && npm run build

# Generate Prisma client
RUN cd backend && npx prisma generate

# Build Express server (TypeScript → dist/)
RUN cd backend && npm run build

# ── Stage 2: Production image ──────────────────────────────────────
FROM node:20-alpine AS runner
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app
ENV NODE_ENV=production

# Copy only what is needed to run
COPY --from=builder /app/package.json          ./
COPY --from=builder /app/node_modules          ./node_modules
COPY --from=builder /app/packages/shared/dist  ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/backend/dist          ./backend/dist
COPY --from=builder /app/backend/prisma        ./backend/prisma
COPY --from=builder /app/backend/package.json  ./backend/

WORKDIR /app/backend
EXPOSE 4000

# Start server immediately (index.ts binds 0.0.0.0:4000 synchronously and initialises DB in background)
CMD ["node", "dist/index.js"]
