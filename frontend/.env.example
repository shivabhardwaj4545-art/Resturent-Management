# ==========================================================
# Frontend Environment Variables (.env.example)
# Copy to frontend/.env.local or frontend/.env
# ==========================================================

# Server-only Backend URL for Next.js API rewrite proxy (keeps cookies first-party)
BACKEND_URL="http://localhost:4000"

# Backend API base URL (can point to /api/v1 for direct or proxy route)
NEXT_PUBLIC_API_URL="/api/v1"

# Backend WebSocket / Socket.io server URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# Razorpay Publishable Key ID for client-side checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Default GST percentage display
NEXT_PUBLIC_GST_RATE="18"
